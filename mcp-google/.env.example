# OAuth 2.0 Client ID credentials from Google Cloud Console
# (APIs & Services > Credentials > Create Credentials > OAuth client ID > Web application).
# Register GOOGLE_REDIRECT_URI below as an authorized redirect URI on that client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8085/oauth2callback

# Obtained by running `npm run oauth-setup` once (see README.md).
GOOGLE_REFRESH_TOKEN=

# This node's secret key, generated with `npm run keygen`. Never share this.
MCP_LOCAL_SECRET_KEY=

# The public key of the single MCP peer this server will exchange encrypted
# messages with, given to you by that peer (their `npm run keygen` output).
MCP_PEER_PUBLIC_KEY=
