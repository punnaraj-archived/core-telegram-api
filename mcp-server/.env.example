# Telegram Bot API server to call. Point this at your own local
# telegram-bot-api server (e.g. http://localhost:8081) or api.telegram.org.
TELEGRAM_BOT_API_URL=https://api.telegram.org

# Bot token issued by @BotFather.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# This node's secret key, generated with `npm run keygen`. Never share this.
MCP_LOCAL_SECRET_KEY=

# The public key of the single MCP peer this server will exchange encrypted
# messages with, given to you by that peer (their `npm run keygen` output).
MCP_PEER_PUBLIC_KEY=
